#!/usr/bin/env bash
# Installs Home Assistant (version pinned via pytest-homeassistant-custom-component)
# plus the integration's requirements.

set -e

cd "$(dirname "$0")/../.."

# System libraries used by Home Assistant's default_config integrations
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
    ffmpeg \
    libturbojpeg0 \
    libpcap-dev

python3 -m pip install --upgrade pip
python3 -m pip install --requirement requirements_test.txt
