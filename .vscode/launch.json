{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "justMyCode": false,
      "args": ["--config", "${workspaceFolder}/.devcontainer/config", "--debug"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "justMyCode": false,
      "args": ["${file}"]
    }
  ]
}
